{
  "manifest_version": 3,
  "name": "🐟 ป้าเข็ม — ผู้ช่วยโพสต์กลุ่ม & รับออเดอร์ช่วยบอท",
  "version": "5.0",
  "description": "ระบบผู้ช่วยโพสต์กลุ่มตลาดนัด + ตอบแชทช่วยบอท + สกัดที่อยู่และบันทึกออเดอร์เข้าฐานข้อมูลบอท (Supabase / Google Sheets / Telegram) 1-คลิก สำหรับร้านปลาสลิดป้าเข็ม",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://usqhvujqmnxqrdoovvnp.supabase.co/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "เปิดเมนูป๊อปอัป ป้าเข็ม ผู้ช่วยกลุ่มตลาดนัด & รับออเดอร์"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
