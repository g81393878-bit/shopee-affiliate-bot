# =============================================================================
# 🛍️ Shopee Affiliate & AI Automation Bot — Commercial Edition (.env Configuration)
# =============================================================================
# คำแนะนำ: คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น `.env` จากนั้นกรอกค่าที่ต้องการใช้งาน

# -----------------------------------------------------------------------------
# 1. การตั้งค่าแบรนด์และ White-Label (Brand Customization)
# -----------------------------------------------------------------------------
BOT_NAME="ป้าเข็ม ขายของ"
BRAND_SLOGAN="คัดของดี ของเด็ด Shopee แท้ 100% • รีวิวแน่น"
BRAND_COLOR="#EE4D2D"
TTS_VOICE="th-TH-PremwadeeNeural"
# ตัวเลือกเสียงพากย์ภาษาไทย (Edge TTS):
# - "th-TH-PremwadeeNeural" (เสียงผู้หญิง / ป้าเข็ม / อบอุ่น นุ่มนวล แนะนำสินค้าดีมาก)
# - "th-TH-NiwatNeural" (เสียงผู้ชาย / มืออาชีพ / มั่นใจ ชัดถ้อยชัดคำ)

# -----------------------------------------------------------------------------
# 2. ฐานข้อมูล (Database Configuration)
# -----------------------------------------------------------------------------
# ตัวเลือกที่ 1: SQLite (ใช้งานในเครื่อง ไม่ต้องตั้งค่าอะไร)
# DATABASE_URL="sqlite:///./affiliate_db.db"

# ตัวเลือกที่ 2: Supabase / PostgreSQL (แนะนำสำหรับออนไลน์ 24/7)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# 3. AI Providers (สมองกลเขียนแคปชั่นและตอบแชท)
# -----------------------------------------------------------------------------
LLM_PROVIDER="groq"
# รองรับหลาย Key คั่นด้วยเครื่องหมายจุลภาค (,) เพื่อสลับ Key อัตโนมัติเมื่อครบโควต้า
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="openai/gpt-oss-120b"

# รองรับ Gemini / Anthropic เป็นตัวสำรองได้:
# GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxx"
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# 4. Facebook Page & Reels Automation (ระบบโพสต์หน้าเพจและคลิปสั้น)
# -----------------------------------------------------------------------------
FACEBOOK_PAGE_ID="1307380735783361"
FACEBOOK_PAGE_ACCESS_TOKEN="EAAR9kFeYyesBSxxxxxxxxxxxxxxxxxxxxxxxx"
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN="my_secret_verify_token"

# ระยะเวลาเว้นช่วงโพสต์ Reels (ชั่วโมง)
POSTING_SPACING_HOURS="2.0"
MAX_REELS_PER_DAY="30"

# -----------------------------------------------------------------------------
# 5. LINE Official Account (บอทตอบแชทลูกค้าและแจ้งเตือนแอดมิน)
# -----------------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LINE_CHANNEL_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LINE_OA_URL="https://line.me/R/ti/p/@137gsref"
ADMIN_LINE_USER_ID=""

# -----------------------------------------------------------------------------
# 6. แดชบอร์ดจัดการระบบ (Admin Dashboard)
# -----------------------------------------------------------------------------
ADMIN_DASHBOARD_PASSWORD="admin_strong_password_123"
CRON_TOKEN="cron_secret_token_123"
