# Server configurations
PORT=8000
HOST=0.0.0.0

# Database configurations
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliate_db

# LLM Providers API Keys
# At least one is required depending on your LLM_PROVIDER choice
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# รองรับหลาย key คั่นด้วยคอมม่า — ระบบจะสลับ/วนใช้ + ข้ามตัวที่ล้มโดยอัตโนมัติ
# GROQ_API_KEY=gsk_aaa...,gsk_bbb...,gsk_ccc...
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider Configuration
# Choose either: 'gemini', 'openai', or 'groq'
LLM_PROVIDER=gemini
# Groq model (OpenAI-compatible API): e.g. llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# LINE Bot Messaging API Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Supabase (Project ref: usqhvujqmnxqrdoovvnp)
# SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key = safe for client-side (needs RLS policies enabled)
# Secret key = server-only, never commit or expose
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Shopee Affiliate Open API (ส่งทางอีเมลโดย Shopee หลังอนุมัติ)
SHOPEE_AFFILIATE_PARTNER_ID=your_partner_id_here
SHOPEE_AFFILIATE_SECRET=your_secret_here

# Web search — ตัวหลัก Tavily (ฟรี 1,000 ครั้ง/เดือน ที่ tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Web search — ตัวสำรอง Firecrawl (ฟรี ที่ firecrawl.dev) ถ้า Tavily ล้ม/หมด quota
# รองรับหลาย key คั่นด้วยคอมม่า หมุนเวียน+failover (แบบเดียวกับ GROQ_API_KEY)
# FIRECRAWL_API_KEY=fc_aaa...,fc_bbb...,fc_ccc...
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ยอดขายขั้นต่ำ (คอลัมน์ "ขาย" ตอน import) ที่บอทจะแนะนำ — ขายน้อยกว่าเกณฑ์ไม่โผล่หน้าลูกค้า
# MIN_SALES=2000

# LINE userId ของเจ้าของร้าน — คนนี้เห็นการ์ดมุมมองแอดมิน (ค่านายหน้า/คะแนน AI/Hook)
# ลูกค้าคนอื่นเห็นแค่การ์ดสะอาด (ราคา/ยอดขาย/ปุ่มซื้อ)
# ADMIN_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token กัน cron endpoint เปิดสาธารณะ (ต้องส่ง ?token= ถึงจะรัน /api/cron/*)
# CRON_TOKEN=your_secret_token
# ราคาลดกี่ % ถึงจะแจ้งเตือนลูกค้า (cron refresh-prices)
# PRICE_DROP_PCT=5
