# Server configurations
PORT=8000
HOST=0.0.0.0

# Database configurations
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliate_db

# LLM Providers API Keys
# At least one is required depending on your LLM_PROVIDER choice
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# รองรับหลาย key คั่นด้วยคอมม่า — ระบบจะสลับ/วนใช้ + ข้ามตัวที่ล้มโดยอัตโนมัติ
# GROQ_API_KEY=gsk_aaa...,gsk_bbb...,gsk_ccc...
GROQ_API_KEY=your_groq_api_key_here
# Anthropic (Claude) — ผ่าน OpenAI-compat endpoint https://api.anthropic.com/v1/ (ไม่ต้องติดตั้ง anthropic SDK)
# รองรับหลาย key คั่นด้วยคอมม่า (หมุนเวียน+failover แบบเดียวกับ GROQ_API_KEY)
# ANTHROPIC_API_KEY=sk-ant-aaa...,sk-ant-bbb...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider Configuration
# Choose either: 'gemini', 'openai', 'groq', or 'anthropic'
LLM_PROVIDER=gemini
# Groq model (OpenAI-compatible API): e.g. llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
# Claude model (OpenAI-compat endpoint): e.g. claude-opus-5 / claude-sonnet-4-6
ANTHROPIC_MODEL=claude-opus-5

# LINE Bot Messaging API Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Facebook Messenger Webhook (docs/facebook-architecture-guide.md)
# App ID/Secret จาก developers.facebook.com → App Settings → Basic
FACEBOOK_APP_ID=1263958805236203
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
# Verify Token — ตั้งเองเป็นรหัสลับ ต้องกรอกให้ตรงในหน้า Webhook ของ Facebook App
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token_here
# Page Access Token — ได้จากขั้นที่ 3 (Connect Page) ใช้ตอบแชทเพจผ่าน Send API
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# ลิงก์ LINE OA จริง (https://line.me/R/ti/p/@xxxxx) — ใช้ในข้อความแนะนำบอทป้าเข็ม
# ถ้าไม่ตั้ง ข้อความจะ fallback เป็นบอกชื่อร้านให้แอดไลน์เอง
LINE_OA_URL=your_line_oa_url_here
# LINE ID ของร้าน (โชว์ในท้ายโพสต์ Facebook ทุกโพสต์ คู่กับ LINE_OA_URL)
LINE_OA_ID=@your_line_id_here

# เลขพร้อมเพย์/บัญชีธนาคารของเจ้าของร้าน — โชว์เป็นข้อความให้ลูกค้าโอนได้เลย (ไม่ใช้ QR)
# (ไม่ตั้ง = ตอบ "โอนตามเลขด้านล่าง" แทน)
OWNER_PROMPTPAY=your_promptpay_number_here
OWNER_BANK_NAME=your_bank_name_here
OWNER_BANK_ACCOUNT=your_bank_account_here
OWNER_BANK_HOLDER=your_bank_account_holder_here

# เขียนโพสต์ Facebook ลง Google ชีทอัตโนมัติ (แยกจากชีทแชทลูกค้า)
# Apps Script: tools/sheet_posts_apps_script.gs → Deploy → Web app → เอา URL มาวางที่นี่
# (ไม่ตั้ง = โพสต์ปกติ แต่ไม่บันทึกชีท)
POSTS_SHEET_WEBHOOK_URL=your_posts_sheet_webhook_url_here

# Supabase (Project ref: usqhvujqmnxqrdoovvnp)
# SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key = safe for client-side (needs RLS policies enabled)
# Secret key = server-only, never commit or expose
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Shopee Affiliate Open API (ส่งทางอีเมลโดย Shopee หลังอนุมัติ)
SHOPEE_AFFILIATE_PARTNER_ID=your_partner_id_here
SHOPEE_AFFILIATE_SECRET=your_secret_here

# Web search — ตัวหลัก Tavily (ฟรี 1,000 ครั้ง/เดือน ที่ tavily.com)
# รองรับหลาย key คั่นด้วยคอมม่า หมุนเวียน+failover (แบบเดียวกับ GROQ_API_KEY)
# TAVILY_API_KEY=tvly_aaa...,tvly_bbb...
TAVILY_API_KEY=your_tavily_api_key_here

# Web search — ตัวสำรอง Firecrawl (ฟรี ที่ firecrawl.dev) ถ้า Tavily ล้ม/หมด quota
# รองรับหลาย key คั่นด้วยคอมม่า หมุนเวียน+failover (แบบเดียวกับ GROQ_API_KEY)
# FIRECRAWL_API_KEY=fc_aaa...,fc_bbb...,fc_ccc...
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ยอดขายขั้นต่ำ (คอลัมน์ "ขาย" ตอน import) ที่บอทจะแนะนำ — ขายน้อยกว่าเกณฑ์ไม่โผล่หน้าลูกค้า
# MIN_SALES=2000

# LINE userId ของเจ้าของร้าน — คนนี้เห็นการ์ดมุมมองแอดมิน (ค่านายหน้า/คะแนน AI/Hook)
# ลูกค้าคนอื่นเห็นแค่การ์ดสะอาด (ราคา/ยอดขาย/ปุ่มซื้อ)
# ADMIN_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token กัน cron endpoint เปิดสาธารณะ (ต้องส่ง ?token= ถึงจะรัน /api/cron/*)
# CRON_TOKEN=your_secret_token
# ราคาลดกี่ % ถึงจะแจ้งเตือนลูกค้า (cron refresh-prices)
# PRICE_DROP_PCT=5

# โพสต์ลงเพจ Facebook อัตโนมัติทุกกี่นาที (0/ไม่ตั้ง = ปิด) — บอทโพสต์เองในตัว ไม่ต้องพึ่ง cron-job.org
# นับจากโพสต์ล่าสุดจริง (main.py _auto_post_due) — หลัง deploy/รีสตาร์ทถ้าเลยกำหนดจะ catch-up ทันที
# 60 = ทุก 1 ชม. · 240 = ทุก 4 ชม.
# FB_AUTO_POST_INTERVAL=60
# Phase 2 โพสต์ขายสินค้า (ทีหลัง): ตั้ง FB_POST_PRODUCTS=1 เพื่อเปิด หลังโพสต์แนะนำตัวครบ
# FB_POST_PRODUCTS=1
